rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Risk attachments — any authenticated user can read/write.
    // Tighten with project membership checks in production.
    match /risks/{riskId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
